<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Dinex — {{.Server.Name}}</title>

<style>
*{box-sizing:border-box}

:root{
    --bg:#111;
    --nav:#171717;
    --panel:#262626;
    --panel2:#303030;
    --border:#404040;
    --text:#f5f5f5;
    --muted:#a3a3a3;
    --cyan:#22d3ee;
    --green:#22c55e;
    --yellow:#eab308;
    --red:#ef4444;
}

body{
    margin:0;
    background:var(--bg);
    color:var(--text);
    font-family:Inter,ui-sans-serif,system-ui,sans-serif;
}

a{
    color:inherit;
    text-decoration:none;
}

.topbar{
    height:56px;
    background:var(--nav);
    box-shadow:0 2px 8px rgba(0,0,0,.35);
}

.topbar-inner{
    max-width:1200px;
    height:100%;
    margin:auto;
    padding:0 16px;
    display:flex;
    align-items:center;
}

.logo{
    flex:1;
    font-size:22px;
    font-weight:600;
}

.logo span{
    color:var(--cyan);
}

.nav{
    height:100%;
    display:flex;
}

.nav a{
    display:flex;
    align-items:center;
    padding:0 18px;
    color:#a3a3a3;
    border-bottom:2px solid transparent;
}

.nav a:hover{
    color:#fff;
}

.nav a.active{
    color:#fff;
    border-bottom-color:var(--cyan);
    background:#101010;
}

.subnav{
    height:48px;
    background:#202020;
    box-shadow:0 2px 5px rgba(0,0,0,.3);
}

.subnav-inner{
    max-width:1200px;
    height:100%;
    margin:auto;
    padding:0 16px;
    display:flex;
    align-items:center;
    gap:4px;
}

.subnav a{
    height:100%;
    display:flex;
    align-items:center;
    padding:0 14px;
    color:#a3a3a3;
    font-size:13px;
    border-bottom:2px solid transparent;
}

.subnav a:hover,
.subnav a.active{
    color:#fff;
    border-bottom-color:var(--cyan);
}

.page{
    max-width:1200px;
    margin:auto;
    padding:32px 16px 48px;
}

.hero{
    display:grid;
    grid-template-columns:1fr auto;
    align-items:end;
    gap:20px;
    margin-bottom:18px;
}

.hero h1{
    margin:0;
    font-size:27px;
    font-weight:600;
}

.hero p{
    margin:5px 0 0;
    color:var(--muted);
    font-size:14px;
}

.status{
    margin-top:10px;
    font-size:13px;
    color:var(--muted);
}

.dot{
    display:inline-block;
    width:8px;
    height:8px;
    margin-right:6px;
    border-radius:50%;
    background:#737373;
}

.running .dot{
    background:var(--green);
}

.offline .dot{
    background:var(--red);
}

.actions{
    display:flex;
    gap:8px;
}

button{
    border:0;
    border-radius:4px;
    padding:10px 17px;
    font:inherit;
    font-weight:600;
    cursor:pointer;
    transition:.15s;
}

.start{
    background:#16a34a;
    color:#fff;
}

.start:hover{
    background:#22c55e;
}

.stop{
    background:#ca8a04;
    color:#fff;
}

.stop:hover{
    background:#eab308;
}

.kill{
    background:#dc2626;
    color:#fff;
}

.kill:hover{
    background:#ef4444;
}

.layout{
    display:grid;
    grid-template-columns:minmax(0,3fr) minmax(260px,1fr);
    gap:16px;
}

.console{
    min-width:0;
    border-radius:5px;
    overflow:hidden;
    background:#000;
    box-shadow:0 4px 12px rgba(0,0,0,.35);
}

.console-head{
    padding:10px 14px;
    background:#1a1a1a;
    border-bottom:1px solid #292929;
    color:#a3a3a3;
    font-size:12px;
    font-family:monospace;
}

.terminal{
    min-height:390px;
    padding:16px;
    background:#000;
    color:#d4d4d4;
    font:12px/1.6 "SFMono-Regular",Consolas,monospace;
    overflow:auto;
}

.prompt{
    color:#facc15;
    font-weight:bold;
}

.command{
    border-top:1px solid #292929;
    background:#171717;
    position:relative;
}

.command input{
    width:100%;
    border:0;
    outline:0;
    padding:12px 14px 12px 38px;
    background:#171717;
    color:#f5f5f5;
    font:13px monospace;
}

.command input:focus{
    border-bottom:2px solid var(--cyan);
}

.command::before{
    content:">";
    position:absolute;
    left:14px;
    top:10px;
    color:#e5e5e5;
    font-weight:bold;
    z-index:1;
}

.stats{
    display:flex;
    flex-direction:column;
    gap:8px;
}

.stat{
    position:relative;
    display:flex;
    align-items:center;
    min-height:82px;
    padding:12px;
    background:#262626;
    border-radius:5px;
    overflow:hidden;
    box-shadow:0 3px 8px rgba(0,0,0,.2);
}

.stat-icon{
    width:42px;
    height:42px;
    margin-right:12px;
    flex:none;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:6px;
    background:#404040;
    color:#e5e5e5;
    font-size:18px;
}

.stat-title{
    color:#a3a3a3;
    font-size:11px;
    text-transform:uppercase;
}

.stat-value{
    margin-top:2px;
    color:#f5f5f5;
    font-weight:600;
    font-size:14px;
    word-break:break-word;
}

.stat-bar{
    position:absolute;
    left:0;
    top:0;
    bottom:0;
    width:3px;
    background:#525252;
}

.server-info{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:8px;
    margin-top:16px;
}

.info{
    background:#262626;
    border-radius:5px;
    padding:16px;
}

.info-title{
    color:#a3a3a3;
    font-size:11px;
    text-transform:uppercase;
}

.info-value{
    margin-top:5px;
    font-size:14px;
    word-break:break-all;
}

@media(max-width:850px){
    .layout{
        grid-template-columns:1fr;
    }

    .stats{
        display:grid;
        grid-template-columns:repeat(2,1fr);
    }
}

@media(max-width:600px){
    .nav a{
        padding:0 8px;
        font-size:12px;
    }

    .hero{
        grid-template-columns:1fr;
        align-items:start;
    }

    .actions{
        width:100%;
    }

    .actions form{
        flex:1;
    }

    .actions button{
        width:100%;
    }

    .subnav-inner{
        overflow-x:auto;
    }

    .server-info{
        grid-template-columns:1fr;
    }

    .stats{
        grid-template-columns:1fr;
    }

    .terminal{
        min-height:300px;
    }
}
</style>
</head>

<body>

<header class="topbar">
<div class="topbar-inner">

<a class="logo" href="/dashboard">Din<span>ex</span></a>

<nav class="nav">
<a href="/dashboard">Dashboard</a>
<a href="/servers" class="active">Servers</a>
<a href="/nodes">Nodes</a>
</nav>

</div>
</header>

<div class="subnav">
<div class="subnav-inner">
<a href="/servers/{{.Server.UUID}}" class="active">Console</a>
<a href="/servers/{{.Server.UUID}}">Overview</a>
</div>
</div>

<main class="page">

<section class="hero">

<div>
<h1>{{.Server.Name}}</h1>

<p>
Server ID: {{.Server.ExternalID}}
</p>

<div class="{{if eq .Status.State "running"}}status running{{else}}status offline{{end}}">
<span class="dot"></span>

{{if .Error}}
Agent Error
{{else if eq .Status.State "running"}}
Running
{{else}}
{{.Status.State}}
{{end}}

</div>
</div>

<div class="actions">

<form method="POST" action="/servers/{{.Server.ID}}/start">
<button class="start">Start</button>
</form>

<form method="POST" action="/servers/{{.Server.ID}}/stop">
<button class="stop">Stop</button>
</form>

<form method="POST" action="/servers/{{.Server.ID}}/kill" onsubmit="return confirm('Forcibly stop this server? This can cause data corruption.')">
<button class="kill">Kill</button>
</form>

</div>

</section>

<div class="layout">

<section>

<div class="console">

<div class="console-head">
console
</div>

<div class="terminal">

{{if .Error}}

<span style="color:#ef4444">Agent error:</span>
{{.Error}}

{{else}}

<span class="prompt">container@dinex~</span> Server connected...

<br>

<span class="prompt">container@dinex~</span> Waiting for console output...

{{end}}

</div>

<div class="command">
<input type="text" placeholder="Type a command..." disabled>
</div>

</div>

<div class="server-info">

<div class="info">
<div class="info-title">Server ID</div>
<div class="info-value">{{.Server.ExternalID}}</div>
</div>

<div class="info">
<div class="info-title">Node</div>
<div class="info-value">{{.Server.NodeID}}</div>
</div>

<div class="info">
<div class="info-title">Process</div>
<div class="info-value">
{{if .Status.PID}}{{.Status.PID}}{{else}}—{{end}}
</div>
</div>

</div>

</section>

<aside class="stats">

<div class="stat">
<div class="stat-bar"></div>
<div class="stat-icon">⌁</div>
<div>
<div class="stat-title">Address</div>
<div class="stat-value">Node {{.Server.NodeID}}</div>
</div>
</div>

<div class="stat">
<div class="stat-bar"></div>
<div class="stat-icon">◷</div>
<div>
<div class="stat-title">Status</div>
<div class="stat-value">{{.Status.State}}</div>
</div>
</div>

<div class="stat">
<div class="stat-bar"></div>
<div class="stat-icon">⚙</div>
<div>
<div class="stat-title">Process</div>
<div class="stat-value">
{{if .Status.PID}}{{.Status.PID}}{{else}}Offline{{end}}
</div>
</div>
</div>

<div class="stat">
<div class="stat-bar"></div>
<div class="stat-icon">▣</div>
<div>
<div class="stat-title">Node ID</div>
<div class="stat-value">{{.Server.NodeID}}</div>
</div>
</div>

</aside>

</div>

</main>

</body>
</html>
