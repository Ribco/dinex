<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Dinex — Dashboard</title>
<style>
*{box-sizing:border-box}
body{
 margin:0;
 font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
 background:#0b0f14;
 color:#e6edf3;
}
a{text-decoration:none;color:inherit}
.layout{display:flex;min-height:100vh}
.sidebar{
 width:240px;
 background:#0f141b;
 border-right:1px solid #222a35;
 padding:22px 14px;
 position:fixed;
 top:0;bottom:0;
}
.brand{
 font-size:22px;
 font-weight:800;
 padding:8px 12px 28px;
}
.brand span{color:#f97316}
.nav-title{
 color:#667085;
 font-size:11px;
 font-weight:800;
 text-transform:uppercase;
 letter-spacing:.08em;
 padding:10px 12px;
}
.nav a{
 display:block;
 padding:11px 12px;
 border-radius:8px;
 color:#9aa4b2;
 margin:3px 0;
}
.nav a:hover,.nav a.active{
 background:#1a222d;
 color:#fff;
}
.content{
 margin-left:240px;
 width:calc(100% - 240px);
}
.topbar{
 height:70px;
 border-bottom:1px solid #222a35;
 display:flex;
 align-items:center;
 justify-content:space-between;
 padding:0 30px;
 background:#0d1218;
}
.topbar h1{font-size:18px;margin:0}
.main{padding:30px;max-width:1250px;margin:auto}
.heading{
 display:flex;
 align-items:center;
 justify-content:space-between;
 gap:15px;
 margin-bottom:25px;
}
.heading h2{margin:0;font-size:25px}
.heading p{margin:5px 0 0;color:#7d8794}
.actions{display:flex;gap:10px;align-items:center}
.btn{
 border:0;
 border-radius:8px;
 padding:10px 15px;
 font-weight:700;
 cursor:pointer;
 background:#f97316;
 color:white;
}
.btn:hover{filter:brightness(1.08)}
.toggle{
 display:flex;
 background:#121821;
 border:1px solid #293342;
 border-radius:9px;
 padding:3px;
}
.toggle button{
 border:0;
 background:transparent;
 color:#8d98a6;
 padding:8px 12px;
 border-radius:6px;
 cursor:pointer;
 font-weight:600;
}
.toggle button.active{
 background:#252e3b;
 color:white;
}
.grid{
 display:grid;
 grid-template-columns:repeat(auto-fill,minmax(290px,1fr));
 gap:15px;
}
.server{
 background:#111821;
 border:1px solid #242e3b;
 border-radius:12px;
 padding:18px;
 transition:.15s;
}
.server:hover{
 border-color:#3a4656;
 transform:translateY(-1px);
}
.server-top{
 display:flex;
 justify-content:space-between;
 gap:10px;
 align-items:flex-start;
}
.server-name{
 font-size:17px;
 font-weight:750;
 margin:0;
}
.server-id{
 color:#697586;
 font-size:12px;
 margin-top:5px;
}
.status{
 display:flex;
 align-items:center;
 gap:7px;
 font-size:12px;
 font-weight:700;
}
.dot{
 width:8px;
 height:8px;
 border-radius:50%;
 background:#667085;
}
.dot.running{background:#22c55e;box-shadow:0 0 8px #22c55e}
.dot.stopped{background:#ef4444}
.server-bottom{
 margin-top:18px;
 padding-top:14px;
 border-top:1px solid #222b36;
 display:flex;
 justify-content:space-between;
 align-items:center;
 color:#7d8794;
 font-size:12px;
}
.open{
 color:#f97316;
 font-weight:700;
}
.empty{
 border:1px dashed #303b49;
 border-radius:12px;
 padding:55px 20px;
 text-align:center;
 color:#7d8794;
}
.empty h3{color:#e6edf3;margin-top:0}
@media(max-width:700px){
 .sidebar{
  position:static;
  width:100%;
  height:auto;
  border-right:0;
  border-bottom:1px solid #222a35;
 }
 .layout{display:block}
 .content{margin-left:0;width:100%}
 .nav{display:flex;overflow:auto}
 .nav-title{display:none}
 .nav a{white-space:nowrap}
 .topbar{display:none}
 .main{padding:20px 15px}
 .heading{align-items:flex-start;flex-direction:column}
 .actions{width:100%;flex-wrap:wrap}
}
</style>
</head>

<body>
<div class="layout">

<aside class="sidebar">
 <div class="brand">♥ <span>Dinex</span></div>

 <div class="nav-title">Manage</div>
 <div class="nav">
  <a class="active" href="/dashboard">Dashboard</a>
  <a href="/servers">Servers</a>
  <a href="/nodes">Nodes</a>
 </div>

 <div class="nav-title">Account</div>
 <div class="nav">
  <a href="/dashboard">Account</a>
 </div>
</aside>

<section class="content">

<header class="topbar">
 <h1>Dashboard</h1>
 <span style="color:#667085">Dinex Panel</span>
</header>

<main class="main">

<div class="heading">
 <div>
  <h2>Servers</h2>
  <p>Manage your Dinex servers.</p>
 </div>

 <div class="actions">
  <div class="toggle">
   <button class="active" onclick="showServers('mine',this)">My Servers</button>
   <button onclick="showServers('all',this)">Everyone</button>
  </div>

  <a class="btn" href="/servers">＋ Add Server</a>
 </div>
</div>

<div id="servers" class="grid">

{{range .}}
<a class="server server-card"
   data-owner="{{.Server.OwnerID}}"
   href="/servers/{{.Server.UUID}}">
 <div class="server-top">
  <div>
   <p class="server-name">{{.Server.Name}}</p>
   <div class="server-id">{{.Server.ExternalID}}</div>
  </div>

  <div class="status">
   {{if eq .Status.State "running"}}
   <span class="dot running"></span> Running
   {{else}}
   <span class="dot stopped"></span> Offline
   {{end}}
  </div>
 </div>

 <div class="server-bottom">
  <span>{{.Server.NodeName}}</span>
  <span class="open">Manage →</span>
 </div>
</a>
{{else}}

<div class="empty">
 <h3>No servers yet</h3>
 <p>Create your first server to get started.</p>
 <a class="btn" href="/servers">＋ Add Server</a>
</div>

{{end}}

</div>
</main>
</section>
</div>

<script>
function showServers(mode,button){
 document.querySelectorAll(".toggle button").forEach(b=>b.classList.remove("active"));
 button.classList.add("active");

 document.querySelectorAll(".server-card").forEach(card=>{
   if(mode==="all"){
     card.style.display="";
   }else{
     card.style.display="";
   }
 });
}
</script>

</body>
</html>
